{
   "$schema": "https://openapi.vercel.sh/vercel.json",
   "rewrites": [
      {
         "source": "/api/:path*",
         "destination": "https://REPLACE-WITH-YOUR-RAILWAY-DOMAIN.up.railway.app/api/:path*"
      },
      {
         "source": "/((?!api/).*)",
         "destination": "/index.html"
      }
   ],
   "headers": [
      {
         "source": "/api/:path*",
         "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
      }
   ]
}
