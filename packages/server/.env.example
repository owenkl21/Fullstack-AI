# Required API keys
OPENAI_API_KEY=your_openai_api_key_here
DATABASE_URL="mysql://root:password@127.0.0.1:3306/fishing_app"
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
# Server config
PORT=3000
CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_R2_ACCESS_KEY_ID=...
CLOUDFLARE_R2_SECRET_ACCESS_KEY=...
CLOUDFLARE_R2_BUCKET=fish-app-media-prod

CLOUDFLARE_R2_PUBLIC_BASE_URL=https://media.example.com
# Auth. BETTER_AUTH_URL is the origin the BROWSER sees, not the port the server
# listens on: the Vite dev server locally, the Vercel domain in production.
BETTER_AUTH_SECRET=generate_a_long_random_string
BETTER_AUTH_URL=http://localhost:5173
APP_ORIGIN=http://localhost:5173
# Email. Resend sends the account mail: verify, reset, password changed and
# welcome. With no key the links are printed to the server log instead, so a
# developer can still finish a sign-up locally without a Resend account.
RESEND_API_KEY=
# Must be an address on the domain verified in Resend. A real mailbox rather
# than a no-reply: replies to account mail are worth reading.
MAIL_FROM=Fisherfeed <info@fisherfeed.com>
MAIL_REPLY_TO=
# Whether a verified address is REQUIRED to use the app. Leave this false until
# a real mail has been seen to arrive in a real inbox. Turning it on before
# that locks every new account out. Move any account on an address that cannot
# take mail (Account, Change email) BEFORE turning it on: after, it cannot sign
# in to do so.
MAIL_PROVIDER_READY=false
