generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
}

/*
 * Who can see a record. PRIVATE is the floor a group feature has to respect:
 * joining a group must never be the thing that publishes an angler's mark.
 */
enum Visibility {
  PRIVATE
  GROUPS
  PUBLIC
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum GroupJoinMode {
  OPEN
  INVITE_ONLY
  CODE
}

enum CompetitionRule {
  SPECIES_POINTS
  BIGGEST_FISH
  SPECIES_VARIETY
}

/*
 * What a fish is judged on. Separate from the rule, which decides how the
 * judging becomes a position: "biggest fish" has to say biggest by what.
 */
/*
 * Which units an angler reads in. South Africa is metric, so that is the
 * default, but plenty of tackle and plenty of visiting anglers are not.
 */
/*
 * What a waypoint is for. A mark on a map means nothing six months later
 * without knowing why it was dropped.
 */
enum WaypointKind {
  MARK
  ACCESS
  HAZARD
  PARKING
  BAIT
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum CompetitionMeasure {
  LENGTH
  WEIGHT
}

/*
 * Who can see and enter. A competition with no group is open to everyone and
 * appears on the global list; GROUP keeps it to its group as before.
 */
enum CompetitionScope {
  PUBLIC
  GROUP
}

enum CompetitionState {
  DRAFT
  OPEN
  CLOSED
}

enum SizeClass {
  EDIBLE
  NON_EDIBLE
}

/* Where the mass on a catch came from. Changes the word on the record, not the
   arithmetic: scoring derives mass from length either way. */
enum WeightSource {
  LENGTH
  SCALE
}

enum WaterType {
  FRESHWATER
  SALTWATER
  BRACKISH
  OTHER
}

enum GearType {
  ROD
  REEL
  BAIT
  LURE
  LINE
  HOOK
  WEIGHTS
}

enum FeedPostType {
  CATCH
  SITE
}

enum FeedScope {
  GLOBAL
  NEARBY
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  emailVerified Boolean      @default(false)
  // The R2 key prefix. Objects are stored under users/<storagePrefixId>/, so
  // this has to stay stable even though the auth id it used to be has gone.
  storagePrefixId String     @unique
  // Nullable now: a new sign-up has no username until the angler picks one.
  username     String?       @unique
  displayName  String
  bio          String?       @db.Text
  avatarUrl    String?
  /* Figures are shown in this: kilograms and centimetres, or pounds and inches. */
  unitSystem   UnitSystem    @default(METRIC)
  /* The photograph across the top of a profile, behind the name. Separate from
   * the avatar: one is who you are, the other is where you fish. */
  bannerUrl    String?
  catches      Catch[]
  sites        FishingSite[]
  reviews      Review[]
  comments     Comment[]
  uploaded     Image[]       @relation("UploadedImages")
  following    Follow[]      @relation("FollowerRelation")
  followers    Follow[]      @relation("FollowingRelation")
  catchLikes   CatchLike[]
  siteLikes    SiteLike[]
  gear         Gear[]
  feedPosts    FeedPost[]
  feedLikes    FeedLike[]
  feedComments FeedComment[]
  sessions     Session[]
  accounts     Account[]
  groupsCreated       Group[]       @relation("GroupsCreated")
  groupMemberships    GroupMember[]
  competitionsCreated Competition[] @relation("CompetitionsCreated")
  competitionEntries  CompetitionEntrant[]
  waypoints           Waypoint[]
  savedSpots          SavedSpot[] @relation("SavedSpots")
  savedGear           SavedGear[] @relation("SavedGear")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@map("users")
}

model FishingSite {
  id          String      @id @default(cuid())
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  name        String
  description String?     @db.Text
  latitude    Float?
  longitude   Float?
  waterType   WaterType?
  /* A spot is the thing anglers most want to keep to themselves. */
  visibility  Visibility @default(PUBLIC)
  accessNotes String?     @db.Text
  likeCount   Int         @default(0)
  reviewCount Int         @default(0)
  catchCount  Int         @default(0)
  catches     Catch[]
  reviews     Review[]
  likes       SiteLike[]
  images      SiteImage[]
  feedPosts   FeedPost[]
  savedBy     SavedSpot[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@index([createdById])
}

model Gear {
  id          String   @id @default(cuid())
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  name        String
  brand       String
  type        GearType
  imageUrl    String?
  catches     Catch[]
  savedBy     SavedGear[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
  @@map("gear")
}

model Species {
  id             String   @id @default(cuid())
  commonName     String
  scientificName String?
  aliases        Json?
  regionTags     Json?
  // Scoring. All optional, so a species with no parameters still logs; it
  // simply does not score, which is visible rather than guessed at.
  lwA            Float?    // FishBase a, total length in cm to grams
  lwB            Float?    // FishBase b
  lwSource       String?   // where a and b came from, printed in the interface
  sizeClass      SizeClass @default(EDIBLE)
  minLegalCm     Int?      // DFFE minimum size
  closedFrom     String?   // "10-15", MM-DD, no year
  closedTo       String?   // "02-28"
  limitsSource   String?   // the brochure and its date
  catches        Catch[]
  competitions   Competition[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Catch {
  id                                      String       @id @default(cuid())
  createdById                             String
  createdBy                               User         @relation(fields: [createdById], references: [id])
  siteId                                  String?
  site                                    FishingSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  speciesId                               String?
  species                                 Species?     @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  gears                                   Gear[]
  title                                   String
  notes                                   String?      @db.Text
  caughtAt                                DateTime
  weight                                  Float?
  length                                  Float?
  // Appendix E gap B5. Until this existed the seed had to put "Released." in
  // the notes text, which no query can read.
  released                                Boolean      @default(false)
  weightSource                            WeightSource @default(LENGTH)
  visibility                              Visibility   @default(PUBLIC)
  count                                   Int          @default(1)
  weather                                 String?
  waterTemp                               Float?
  weatherCurrentTime                      DateTime?
  weatherTimeZoneId                       String?
  weatherConditionType                    String?
  weatherConditionText                    String?
  weatherConditionIconBaseUri             String?
  weatherTemperatureDegrees               Float?
  weatherTemperatureUnit                  String?
  weatherFeelsLikeTemperatureDegrees      Float?
  weatherFeelsLikeTemperatureUnit         String?
  weatherDewPointDegrees                  Float?
  weatherDewPointUnit                     String?
  weatherPrecipitationProbability         Int?
  weatherAirPressureMeanSeaLevelMillibars Int?
  weatherWindDirectionDegrees             Int?
  weatherWindDirectionCardinal            String?
  weatherWindSpeedValue                   Float?
  weatherWindSpeedUnit                    String?
  weatherWindGustValue                    Float?
  weatherWindGustUnit                     String?
  weatherVisibilityDistanceValue          Float?
  weatherVisibilityDistanceUnit           String?
  weatherIsDaytime                        Boolean?
  weatherRelativeHumidity                 Int?

  /*
   * The rest of the reading. These were being fetched and shown and then
   * dropped on save, so a catch could tell you the air pressure at the time and
   * not the water temperature, which is the one a shore angler would ask about
   * first. A record that cannot answer that is not a record of the conditions.
   */
  weatherSeaSurfaceTemperatureC           Float?
  weatherWaveHeightM                      Float?
  weatherSwellHeightM                     Float?
  weatherSwellPeriodS                     Float?
  weatherSunrise                          DateTime?
  weatherSunset                           DateTime?
  /* Worked out from the date rather than fetched, and kept so the record does
   * not have to recompute it against a changing definition later. */
  weatherMoonPhase                        String?
  weatherMoonIllumination                 Float?
  weatherMoonSpringTide                   Boolean?

  /*
   * Show the catch, hide where it came from.
   *
   * Separate from visibility on purpose. Visibility asks who may see the catch
   * at all; this asks whether its position travels with it. An angler will
   * happily show a fish and not the gully it came out of, and forcing that
   * choice to be all or nothing is how a log stops being used.
   *
   * The position is still stored. It is withheld from other anglers, not
   * discarded, so the record stays complete.
   */
  hideLocation                            Boolean  @default(false)
  weatherUvIndex                          Int?
  weatherThunderstormProbability          Int?
  weatherCloudCover                       Int?
  depth                                   Float?
  likeCount                               Int          @default(0)
  commentCount                            Int          @default(0)
  comments                                Comment[]
  likes                                   CatchLike[]
  images                                  CatchImage[]
  feedPosts                               FeedPost[]
  createdAt                               DateTime     @default(now())
  updatedAt                               DateTime     @updatedAt
  deletedAt                               DateTime?

  @@index([createdById, caughtAt(sort: Desc)])
  @@index([siteId, caughtAt(sort: Desc)])
}

model Review {
  id        String      @id @default(cuid())
  siteId    String
  site      FishingSite @relation(fields: [siteId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  rating    Int
  body      String      @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  @@unique([siteId, userId])
  @@index([siteId, createdAt(sort: Desc)])
}

model Comment {
  id        String    @id @default(cuid())
  catchId   String
  catch     Catch     @relation(fields: [catchId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  body      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([catchId, createdAt(sort: Asc)])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("FollowerRelation", fields: [followerId], references: [id])
  following   User     @relation("FollowingRelation", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model CatchLike {
  id        String   @id @default(cuid())
  catchId   String
  catch     Catch    @relation(fields: [catchId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([catchId, userId])
}

model SiteLike {
  id        String      @id @default(cuid())
  siteId    String
  site      FishingSite @relation(fields: [siteId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([siteId, userId])
}

model Image {
  id           String       @id @default(cuid())
  url          String       @db.VarChar(512)
  storageKey   String       @unique @db.VarChar(512)
  uploadedById String
  uploadedBy   User         @relation("UploadedImages", fields: [uploadedById], references: [id])
  catchLinks   CatchImage[]
  siteLinks    SiteImage[]
  createdAt    DateTime     @default(now())
}

model CatchImage {
  id       String @id @default(cuid())
  catchId  String
  catch    Catch  @relation(fields: [catchId], references: [id])
  imageId  String
  image    Image  @relation(fields: [imageId], references: [id])
  position Int    @default(0)

  @@unique([catchId, imageId])
}

model SiteImage {
  id       String      @id @default(cuid())
  siteId   String
  site     FishingSite @relation(fields: [siteId], references: [id])
  imageId  String
  image    Image       @relation(fields: [imageId], references: [id])
  position Int         @default(0)

  @@unique([siteId, imageId])
}

model FeedPost {
  id           String        @id @default(cuid())
  authorId     String
  author       User          @relation(fields: [authorId], references: [id])
  type         FeedPostType
  scope        FeedScope     @default(GLOBAL)
  visibility   Visibility    @default(PUBLIC)
  groupId      String?
  group        Group?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  content      String?       @db.Text
  catchId      String?
  catch        Catch?        @relation(fields: [catchId], references: [id], onDelete: SetNull)
  siteId       String?
  site         FishingSite?  @relation(fields: [siteId], references: [id], onDelete: SetNull)
  latitude     Float?
  longitude    Float?
  likeCount    Int           @default(0)
  commentCount Int           @default(0)
  likes        FeedLike[]
  comments     FeedComment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@index([createdAt(sort: Desc)])
  @@index([scope, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
}

model FeedLike {
  id        String   @id @default(cuid())
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model FeedComment {
  id        String    @id @default(cuid())
  postId    String
  post      FeedPost  @relation(fields: [postId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  body      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([postId, createdAt(sort: Desc)])
}

/* ---------- better-auth. Field names are its own, do not rename them. ---------- */

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/* ---------- Groups and competitions ---------- */

model Group {
  id           String        @id @default(cuid())
  name         String
  blurb        String?       @db.VarChar(280)
  createdById  String
  createdBy    User          @relation("GroupsCreated", fields: [createdById], references: [id])
  joinMode     GroupJoinMode @default(INVITE_ONLY)
  joinCode     String?       @unique
  memberCount  Int           @default(0)
  members      GroupMember[]
  competitions Competition[]
  feedPosts    FeedPost[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@index([createdById])
  @@map("groups")
}

model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([groupId, userId])
  @@index([userId, leftAt])
  @@map("group_members")
}

model Competition {
  id          String           @id @default(cuid())
  name        String
  groupId     String?
  group       Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User             @relation("CompetitionsCreated", fields: [createdById], references: [id])
  rule        CompetitionRule  @default(SPECIES_POINTS)
  measure     CompetitionMeasure @default(LENGTH)
  scope       CompetitionScope   @default(GROUP)
  /* What the organiser wrote about it, shown on the listing. */
  blurb       String?            @db.VarChar(280)
  entrants    CompetitionEntrant[]
  /* Set, and it is a target-species competition rather than a fourth rule. */
  speciesId   String?
  species     Species?         @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  startsAt    DateTime
  endsAt      DateTime
  /*
   * A South African competition that ends "on Sunday" ends at 23:59 in
   * Africa/Johannesburg and nowhere else, so the zone travels with the dates.
   */
  timeZoneId  String           @default("Africa/Johannesburg")
  state       CompetitionState @default(DRAFT)
  maxPerSpeciesPerDay Int      @default(3)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  @@index([groupId, startsAt(sort: Desc)])
  @@index([scope, startsAt(sort: Desc)])
  @@map("competitions")
}

/*
 * Who entered. Standings are still worked out from the catches themselves, so
 * this records intent to compete rather than any score: a derived board cannot
 * drift from the records it describes, and this keeps that true.
 */
/*
 * A private mark on the map.
 *
 * Never shared, with nobody, ever. There is no visibility column here on
 * purpose: a spot has one because a spot can be shown to people, and the moment
 * a waypoint grows one somebody will set it wrong. A fishing mark is the most
 * closely held thing an angler has, and the promise the interface makes is that
 * these are only ever yours.
 */
/*
 * Somebody else's spot or piece of gear, kept.
 *
 * A reference rather than a copy. Copying would freeze a name and a position
 * that the owner can still change, and would quietly turn a spot somebody later
 * made private into one you still hold. Holding the id means the moment they
 * withdraw it, it stops resolving, which is the behaviour anyone would expect.
 */
model SavedSpot {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation("SavedSpots", fields: [userId], references: [id], onDelete: Cascade)
  siteId    String
  site      FishingSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  note      String?      @db.VarChar(500)
  createdAt DateTime     @default(now())

  @@unique([userId, siteId])
  @@index([userId])
  @@map("saved_spots")
}

model SavedGear {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("SavedGear", fields: [userId], references: [id], onDelete: Cascade)
  gearId    String
  gear      Gear     @relation(fields: [gearId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, gearId])
  @@index([userId])
  @@map("saved_gear")
}

model Waypoint {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String       @db.VarChar(120)
  note      String?      @db.VarChar(500)
  kind      WaypointKind @default(MARK)
  latitude  Float
  longitude Float
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  @@index([userId, deletedAt])
  @@map("waypoints")
}

model CompetitionEntrant {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt      DateTime    @default(now())
  leftAt        DateTime?

  @@unique([competitionId, userId])
  @@index([userId, leftAt])
  @@map("competition_entrants")
}
